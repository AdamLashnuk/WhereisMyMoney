# NVIDIA NIM key for Person C's Nemotron (ai/). When set, /log-expense uses
# ai.categorize.categorize_expense and over-limit / weekly calls use Nemotron
# phrasing. Leave blank to keep the offline heuristic parser and speech templates.
NVIDIA_API_KEY=
# ElevenLabs. Same key is used for Scribe STT (voice uploads) and TTS (Victoria
# voice on outbound Twilio calls via ai/elevenlabs_tts.py). Leave blank to skip
# ElevenLabs. Never commit a real key — set it in backend/.env or the repo-root .env.
ELEVENLABS_API_KEY=
# Optional Scribe model id. Default scribe_v2.
ELEVENLABS_STT_MODEL=scribe_v2
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MY_PHONE_NUMBER=
# Public HTTPS origin of THIS FastAPI process (ngrok). Twilio fetches
# /twiml/play/{token} and /call-audio/{token}.mp3 from here — localhost will not
# work. Example: https://xxxx.ngrok-free.app  (no trailing slash)
# Alias: CALL_AUDIO_BASE_URL
PUBLIC_BASE_URL=
CALL_AUDIO_BASE_URL=
WHISPER_STUB=1
OPENAI_API_KEY=
WHISPER_MODEL=base
TZ=America/New_York
WHEREISMYMONEY_DB=

