# NVIDIA NIM key for Person C's Nemotron (ai/). When set, /log-expense uses
# ai.categorize.categorize_expense and over-limit / weekly calls use Nemotron
# phrasing. Leave blank to keep the offline heuristic parser and speech templates.
NVIDIA_API_KEY=
# ElevenLabs Speech-to-Text (Scribe). When WHISPER_STUB is off and this is set,
# voice uploads POST to api.elevenlabs.io/v1/speech-to-text first, then OpenAI,
# then local whisper, then the stub. Leave blank to skip ElevenLabs. Never commit
# a real key — Person C / the team set this in backend/.env or the repo-root .env.
ELEVENLABS_API_KEY=
# Optional Scribe model id. Default scribe_v2.
ELEVENLABS_STT_MODEL=scribe_v2
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MY_PHONE_NUMBER=
WHISPER_STUB=1
OPENAI_API_KEY=
WHISPER_MODEL=base
TZ=America/New_York
WHEREISMYMONEY_DB=

